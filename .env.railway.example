DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=YOUR_DJANGO_SECRET_KEY_MIN_50_CHARS
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=.up.railway.app,healthcheck.railway.app,YOUR_PUBLIC_DOMAIN_IF_ANY

LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

DATABASE_URL=postgresql://YOUR_PGUSER:YOUR_PGPASSWORD@YOUR_PUBLIC_HOST.proxy.rlwy.net:YOUR_PORT/YOUR_PGDATABASE

REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT

# Redis GEO dispatch + FCM offer fallback
DISPATCH_RADIUS_KM=10
DRIVER_LOCATION_TTL_SECONDS=45
OFFER_WINDOW_SECONDS=30
OFFER_ACK_WAIT_SECONDS=4
FIREBASE_SERVICE_ACCOUNT_PATH=
# Or paste the full service-account JSON (single line) — preferred on Railway:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"carryoo-c6c74",...}

# Expo Go / QA phone login — fixed OTP, works without shared Redis cache across workers
OTP_DEV_BYPASS=123456

CORS_ALLOWED_ORIGINS=https://your-frontend.example.com,http://localhost:8081
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com
